<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Platforms>AnyCPU;x64;OrangePI</Platforms>
  </PropertyGroup>

  <!-- Platforma OrangePI (Armbian/ARM64) -> IsARM64 (stejny styl jako IsX64/IsX86).
       Rozhoduje o vyberu HAL a o platform-specific #if v C# (napr. D435TestDocument). -->
  <PropertyGroup Condition="'$(Platform)' == 'OrangePI'">
    <DefineConstants>$(DefineConstants);IsARM64</DefineConstants>
  </PropertyGroup>
    <PropertyGroup Condition="'$(Platform)' == 'x64'">
	    <DefineConstants>$(DefineConstants);IsX64</DefineConstants>
	    <!-- GC: NECHAT defaultni Workstation + background (Concurrent). Server GC byl zkousen a
	         ZHORSIL latenci (viz doc/devlog.md 2026-07-30): jeho background GC vlakna pri mnoha
	         stupnich pipeline pretizila CPU (compute wall-time vzrostl, >100ms z 8 % na 20 %).
	         Trvale reseni GC spicek je snizit alokace (pooling image bufferu kamer), ne menit rezim. -->
	    <ServerGarbageCollection>false</ServerGarbageCollection>
	    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Platform)' == 'x86'">
	    <DefineConstants>$(DefineConstants);IsX86</DefineConstants>
    </PropertyGroup>

	<ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <Folder Include="Robot\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="Dock.Avalonia" Version="12.0.0.2" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.0.0.2" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.0.0.2" />

    <!-- World pohled (mapa): Mapsui pro Avalonia 12 + NTS (cary/geometrie) + MBTiles (offline podklad).
         Base vrstvu lze vypnout (viz WorldViewDocument) -> na OrangePI zadne pokusy o internet.
         Pozn.: Mapsui renderuje pres SkiaSharp; na ARM64 overit nativni SkiaSharp assety na zarizeni. -->
    <PackageReference Include="Mapsui.Avalonia12" Version="5.1.0" />
    <PackageReference Include="Mapsui.Nts" Version="5.1.0" />
    <PackageReference Include="BruTile.MbTiles" Version="6.0.0" />

	  <Reference Include="FTD2XX_NET" Condition="'$(Platform)' == 'x64'">
		  <HintPath>..\ARBot.HALWindows\FTD2XX_NET.dll</HintPath>
	  </Reference>

  </ItemGroup>

  <!-- Platform-dedikovany HAL: OrangePI -> HALArmbian (RealSense 2.53),
       jinak (x64/x86/AnyCPU) -> HALWindows (RealSense 2.47). -->
  <ItemGroup Condition="'$(Platform)' == 'OrangePI'">
    <ProjectReference Include="..\ARBot.HALArmbian\ARBot.HALArmbian.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Platform)' != 'OrangePI'">
    <ProjectReference Include="..\ARBot.HALWindows\ARBot.HALWindows.csproj" />
  </ItemGroup>
</Project>
