<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ARBot.App"
             xmlns:local="using:ARBot"
             xmlns:vm="using:ARBot.ViewModels"
             xmlns:dockThemes="using:Dock.Avalonia.Themes.Fluent"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
        <DataTemplate DataType="vm:D435TestDocument">
            <Grid Background="#202020">
                <Image Source="{Binding Image}" Stretch="Uniform"/>
                <TextBlock Text="{Binding Status}" Foreground="Lime" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                           Background="#80000000" Padding="6,3"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="vm:DebugOutputTool">
            <Grid RowDefinitions="Auto,*">
                <Button Grid.Row="0" Content="Clear" Command="{Binding ClearCommand}"
                        HorizontalAlignment="Left" Margin="4"/>
                <TextBox Grid.Row="1" Text="{Binding Text}"
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Consolas,Menlo,monospace"
                         VerticalContentAlignment="Top"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="vm:SensorStatusTool">
            <Grid RowDefinitions="Auto,Auto,*">
                <Button Grid.Row="0" Content="Refresh" Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Left" Margin="4"/>
                <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="Gray"
                           Margin="6,0,6,4" TextWrapping="Wrap"/>
                <ScrollViewer Grid.Row="2">
                    <ItemsControl ItemsSource="{Binding Sensors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SensorRow">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,3">
                                    <Border Grid.Column="0" Width="12" Height="12" CornerRadius="6"
                                            VerticalAlignment="Center" Background="{Binding StatusBrush}"/>
                                    <TextBlock Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center"
                                               Text="{Binding Name}"/>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DataTemplate>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <dockThemes:DockFluentTheme />
    </Application.Styles>
</Application>