<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ARBot.ViewModels"
             x:Class="ARBot.Views.DebugOutputToolView"
             x:DataType="vm:DebugOutputTool">
    <Design.DataContext>
        <vm:DebugOutputTool/>
    </Design.DataContext>
    <Grid RowDefinitions="Auto,*">
        <Button Grid.Row="0" Content="Clear" Command="{Binding ClearCommand}"
                HorizontalAlignment="Left" Margin="4"/>
        <TextBox Grid.Row="1" Text="{Binding Text}"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas,Menlo,monospace"
                 VerticalContentAlignment="Top"/>
    </Grid>
</UserControl>
