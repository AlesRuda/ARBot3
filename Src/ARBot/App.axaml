<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ARBot.App"
             xmlns:local="using:ARBot"
             xmlns:dockThemes="using:Dock.Avalonia.Themes.Fluent"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <!-- View se vytvari podle typu dockable: DocumentBase/ToolBase.ViewType (viz ViewLocator),
             jinak konvence nazvu ...ViewModel -> ...View. Prezentacni UserControly jsou ve Views/. -->
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <dockThemes:DockFluentTheme />
        <!-- Tema DataGridu (telemetricky pohled). Bez nej se DataGrid vykresli jako prazdne misto. -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <!-- Spolecny vzhled tlacitek (obsah na stredu, jeden padding, citelny zakazany stav).
             Musi byt ZA Fluent temou, aby ji prebilo. Viz Styles/Buttons.axaml. -->
        <StyleInclude Source="avares://ARBot/Styles/Buttons.axaml"/>
    </Application.Styles>
</Application>
