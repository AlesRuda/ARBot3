<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ARBot.ViewModels"
             x:Class="ARBot.Views.ConfigurationDocumentView"
             x:DataType="vm:ConfigurationDocument">
    <Design.DataContext><vm:ConfigurationDocument/></Design.DataContext>

    <!-- Bunka sloupce Hodnota. Sablonu vybira Avalonia PODLE TYPU RADKU, takze v bunce je vzdy
         prave jeden prvek.

         ⚠️ NEVRACET zpet na jednu sablonu se dvema prvky prepinanymi pres IsVisible. Presne tak to
         bylo napsane poprve a byla to VADA: kdyz DataGrid pri virtualizaci recykloval kontejner
         z radku S vyctem na radek BEZ nej, dostal skryty ComboBox prazdny ItemsSource, nenasel
         v nem svou hodnotu, nastavil SelectedItem = null - a obousmerny binding to zapsal zpatky
         do Value. Hodnota se tim SKUTECNE ztratila (ulozeny profil uz ji neobsahoval), nejen
         prestala byt videt. Reprodukce: NEmaximalizovane okno + scroll na dotcenty radek.
         Nalezeno 31. 8. 2026, viz doc/configuration.md. -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:ChoiceParamRow">
            <ComboBox Margin="4,2" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Choices}"
                      SelectedItem="{Binding Value, Mode=TwoWay}"/>
        </DataTemplate>
        <DataTemplate DataType="vm:TextParamRow">
            <TextBox Margin="4,2" Text="{Binding Value, Mode=TwoWay}"/>
        </DataTemplate>
    </UserControl.DataTemplates>

    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBox Width="220" PlaceholderText="Filtr (jméno nebo popis)"
                     Text="{Binding Filter, Mode=TwoWay}"/>
            <!-- Cesta je hlavne INFORMACE, kam pujde „Ulozit" (bez ni by tlacitko zapisovalo
                 neznamo kam). Zustava editovatelna zamerne: v prostredi bez spravce souboru je to
                 jedina cesta, jak profil urcit bez dialogu. -->
            <TextBox Width="320" PlaceholderText="Profil — kam se uloží (např. config/muj.cfg)"
                     Text="{Binding ProfilePath, Mode=TwoWay}"
                     ToolTip.Tip="Soubor, se kterým panel pracuje. Prázdné = „Uložit“ se zeptá."/>
            <Button Classes="btn action info" Content="Načíst profil…"
                    Command="{Binding LoadCommand}"
                    ToolTip.Tip="Načte profil do tabulky. Nic nespustí — hodnoty začnou platit až po restartu. Co v profilu není, se vrátí na výchozí."/>
            <Button Classes="btn action accent" Content="Uložit"
                    Command="{Binding SaveCommand}"
                    ToolTip.Tip="Zapíše do souboru uvedeného v cestě. Když žádný není, zeptá se. Ukládají se jen hodnoty odlišné od výchozích, s popisem v komentáři."/>
            <Button Classes="btn action" Content="Uložit jako…"
                    Command="{Binding SaveAsCommand}"
                    ToolTip.Tip="Vždy se zeptá, kam profil uložit."/>
            <Button Classes="btn action danger" Content="Uložit a restartovat"
                    Command="{Binding SaveAndRestartCommand}"
                    ToolTip.Tip="Uloží profil a spustí aplikaci znovu jen s ním. Běžící Run i mise skončí."/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0"
                   Text="{Binding Status}" TextWrapping="Wrap"/>

        <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="False"
                  AutoGenerateColumns="False" CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal">
            <!-- Bublina s popisem na CELEM radku, ne jen nad sloupcem Popis: ten je uzky a dlouhy
                 popis se do nej nevejde, a hlavne ho clovek potrebuje videt prave ve chvili, kdy
                 najede na sloupec Hodnota. Text sklada ParamRow.Tooltip (popis + typ + vychozi). -->
            <DataGrid.Styles>
                <Style Selector="DataGridRow" x:DataType="vm:ParamRow">
                    <Setter Property="ToolTip.Tip" Value="{Binding Tooltip}"/>
                    <Setter Property="ToolTip.ShowDelay" Value="400"/>
                </Style>
            </DataGrid.Styles>

            <!-- x:DataType na KAZDEM sloupci je nutnost, ne ozdoba: bez nej se binding resolvuje
                 az za behu a preklep ve jmene by byl TICHY - hlasky oblasti Binding jsou ve
                 FilteredTraceLogSink odfiltrovane (viz Views/README.md). Takhle ho chyti build. -->
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kategorie" x:DataType="vm:ParamRow"
                                    Binding="{Binding Category}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Klíč" x:DataType="vm:ParamRow"
                                    Binding="{Binding Name}" IsReadOnly="True"/>
                <!-- ContentControl si sablonu najde podle typu radku (viz UserControl.DataTemplates).
                     Zobrazovaci i editacni sablona jsou stejne: prvek uvnitr je sam interaktivni,
                     takze editacni rezim DataGridu nema co pridat - ale kdyz do nej tabulka
                     prepne, musi mit co vykreslit. -->
                <DataGridTemplateColumn Header="Hodnota" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><ContentControl Content="{Binding}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate><ContentControl Content="{Binding}"/></DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Výchozí" x:DataType="vm:ParamRow"
                                    Binding="{Binding DefaultText}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Původ" x:DataType="vm:ParamRow"
                                    Binding="{Binding Origin}" IsReadOnly="True"/>
                <!-- Sloupec „Chyba" tu BYVAL a je zrusen zamerne: vadne pole se pozna cervenym
                     ramcem a duvod rekne bublina primo u nej (Styles/Validation.axaml). Sloupec
                     bral misto a odsouval hlasku daleko od pole, ktereho se tykala. -->
                <DataGridTextColumn Header="Popis" x:DataType="vm:ParamRow"
                                    Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
