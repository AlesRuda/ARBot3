<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ARBot.ViewModels"
             x:Class="ARBot.Views.DebugOutputToolView"
             x:DataType="vm:DebugOutputTool">
    <Design.DataContext>
        <vm:DebugOutputTool/>
    </Design.DataContext>
    <Grid RowDefinitions="Auto,*">
        <Button Grid.Row="0" Classes="btn compact" Content="Clear" Command="{Binding ClearCommand}"
                HorizontalAlignment="Left" Margin="4"/>
        <!-- Virtualizovany list radku: vykresluji se jen viditelne polozky (na rozdil od
             jednoho velkeho TextBoxu, ktery se cely znovu skladal pri kazde aktualizaci). -->
        <ListBox Grid.Row="1" x:Name="LinesList"
                 ItemsSource="{Binding Lines}"
                 SelectionMode="Multiple"
                 FontFamily="Consolas,Menlo,monospace"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
                <!-- Kompaktni radky bez zbytecneho paddingu. -->
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="4,0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <SelectableTextBlock Text="{Binding}" TextWrapping="NoWrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
