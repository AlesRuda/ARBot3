<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ARBot.ViewModels"
             x:Class="ARBot.Views.ImageDocumentView"
             x:DataType="vm:ImageDocument">
    <Design.DataContext>
        <vm:ImageDocument/>
    </Design.DataContext>
    <Grid RowDefinitions="Auto,*" Background="#202020">
        <!-- Ovladaci radek: vyber vrstev do slotu + pruhlednost overlaye -->
        <WrapPanel Grid.Row="0" Margin="8,6" VerticalAlignment="Center">
            <TextBlock Text="Levý:" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox ItemsSource="{Binding Layers}" SelectedItem="{Binding LeftLayer}"
                      MinWidth="180" Margin="0,0,12,0"/>
            <TextBlock Text="Pravý:" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox ItemsSource="{Binding Layers}" SelectedItem="{Binding RightLayer}"
                      MinWidth="180" Margin="0,0,12,0"/>
            <TextBlock Text="Overlay L:" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox ItemsSource="{Binding Layers}" SelectedItem="{Binding LeftOverlayLayer}"
                      MinWidth="160" Margin="0,0,12,0"/>
            <TextBlock Text="Overlay P:" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox ItemsSource="{Binding Layers}" SelectedItem="{Binding RightOverlayLayer}"
                      MinWidth="160" Margin="0,0,12,0"/>
            <TextBlock Text="Průhlednost:" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <Slider Minimum="0" Maximum="1" Value="{Binding OverlayOpacity}" Width="130"
                    VerticalAlignment="Center"/>
            <!-- Prah masky: zapnuto = ostra hrana jako v ARBot2 (ten mel binarni uz samotnou
                 pravdepodobnost), vypnuto = plynuly prechod, na kterem je videt, kde si sit
                 neni jista. Meni BITMAPU, takze prepnuti si vynuti prekresleni ve ViewModelu. -->
            <CheckBox IsChecked="{Binding MaskThresholdOn}" Margin="12,0,0,0"
                      VerticalAlignment="Center" Foreground="White"
                      Content="Práh masky 0,5"
                      ToolTip.Tip="Maska kryje naplno nad pravděpodobností 0,5 a jinde vůbec (ostrá hrana jako v ARBot2). Vypnuto = krytí roste plynule s pravděpodobností."/>
        </WrapPanel>

        <!-- Dva panely: levy a pravy snimek, kazdy s polopruhlednym overlayem -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="8,0,8,8">
            <!-- Viewbox drzi POMER STRAN SCENY (LeftSceneWidth/Height z ImageDocument), vnitrni
                 Grid ma jeji rozmery v pixelech a oba obrazky se do nej kresli Stretch="Fill".
                 ⚠️ Tim overlay lezi PRESNE na podkladu i kdyz ma jine rozliseni - pravdepodobnost
                 ze site je 128×128, ale pokryva cely snimek 640×480. S Uniform na obou prvcich
                 si kazdy zachoval vlastni pomer, takze probability skoncila jako ctverec pres
                 prostrednich 75 % sirky obrazu (nalez 10. 9. 2026, doc/devlog.md).
                 Popiska je ZAMERNE mimo Viewbox - jinak by se skalovala i ona.

                 ⚠️ Overlay se NEVYPINA vyhlazovani. Maska je prahovana (viz RenderProbabilityMask),
                 takze hrana uz je ostra sama o sobe a vyhlazovani ji jen vyhladi pres jeden zdrojovy
                 pixel - presne jako v ARBot2, ktery to ve WPF taky nechal na vychozim nastaveni.
                 BitmapInterpolationMode="None" by udelalo tvrde schody bloku masky (pri 128x128
                 asi 5x4 px sceny); je to jednoradkova zmena, kdyby to nekdo chtel jeste ostrejsi.

                 Kurzor obsluhuje vnitrni Grid (Background="Transparent" kvuli hit-testu), takze
                 poloha z e.GetPosition JSOU scenove pixely; overlay ma IsHitTestVisible=False.
                 Tag rozlisuje panel (L/P) v obsluze v code-behind.

                 ⚠️ Oba snimky se DOTYKAJI (zadna mezera) - lip to odpovida pohledu z robotu,
                 kde jsou kamery vedle sebe. Nestaci na to zrusit okraje mezi sloupci: Viewbox
                 se Stretch="Uniform" sve dite CENTRUJE, takze kdyz je sloupec sirsi nez pomer
                 stran snimku, zbyde prazdne misto po OBOU stranach kazdeho snimku a mezera mezi
                 nimi zustane i pri nulovem okraji. Proto je levy Viewbox zarovnany doprava
                 a pravy doleva - snimky se tim potkaji uprostred a prazdne misto (pokud nejake
                 je) odejde na vnejsi kraje. -->
            <Grid Grid.Column="0">
                <Viewbox Stretch="Uniform" HorizontalAlignment="Right">
                    <Grid Width="{Binding LeftSceneWidth}" Height="{Binding LeftSceneHeight}"
                          Background="Transparent" Tag="L"
                          PointerMoved="OnImagePointerMoved" PointerExited="OnImagePointerExited">
                        <Image Source="{Binding LeftImage}" Stretch="Fill"/>
                        <Image Source="{Binding LeftOverlayImage}" Stretch="Fill"
                               Opacity="{Binding OverlayOpacity}" IsHitTestVisible="False"/>
                    </Grid>
                </Viewbox>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6"
                        Background="#80000000" Padding="8,4" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="{Binding LeftInfo}" Foreground="White" FontFamily="Consolas,monospace"/>
                        <TextBlock Text="{Binding LeftOverlayInfo}" Foreground="#A0FFFFFF" FontFamily="Consolas,monospace"/>
                        <TextBlock Text="{Binding LeftCursorInfo}" Foreground="#FFD080" FontFamily="Consolas,monospace"
                                   IsVisible="{Binding LeftCursorInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Column="1">
                <Viewbox Stretch="Uniform" HorizontalAlignment="Left">
                    <Grid Width="{Binding RightSceneWidth}" Height="{Binding RightSceneHeight}"
                          Background="Transparent" Tag="R"
                          PointerMoved="OnImagePointerMoved" PointerExited="OnImagePointerExited">
                        <Image Source="{Binding RightImage}" Stretch="Fill"/>
                        <Image Source="{Binding RightOverlayImage}" Stretch="Fill"
                               Opacity="{Binding OverlayOpacity}" IsHitTestVisible="False"/>
                    </Grid>
                </Viewbox>
                <!-- Popiska praveho panelu je u PRAVEHO okraje: oba snimky se ted dotykaji
                     uprostred, takze vlevo by sedela primo na spoji a prekryvala by konec
                     leveho snimku. Takhle jsou obe popisky ve vnejsich rozich. -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                        Background="#80000000" Padding="8,4" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="{Binding RightInfo}" Foreground="White" FontFamily="Consolas,monospace"/>
                        <TextBlock Text="{Binding RightOverlayInfo}" Foreground="#A0FFFFFF" FontFamily="Consolas,monospace"/>
                        <TextBlock Text="{Binding RightCursorInfo}" Foreground="#FFD080" FontFamily="Consolas,monospace"
                                   IsVisible="{Binding RightCursorInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
