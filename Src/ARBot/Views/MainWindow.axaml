<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ARBot.ViewModels"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ARBot.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ARBot">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Open" Command="{Binding OpenCommand}"/>
                <MenuItem Header="Save" Command="{Binding SaveCommand}"/>
            </MenuItem>
            <MenuItem Header="Runtime">
                <MenuItem Header="Run without log" Command="{Binding RunModeCommand}"/>
                <MenuItem Header="Run and log" Command="{Binding RunAndLogCommand}"/>
                <MenuItem Header="View…" Command="{Binding ViewModeCommand}"/>
                <Separator/>
                <MenuItem Header="Stop" Command="{Binding StopRuntimeCommand}"/>
                <Separator/>
                <MenuItem Header="Hardware"
                          ToolTip.Tip="Co se založí při dalším spuštění Run.&#10;Přepínat lze jen se zastaveným runtime.">
                    <MenuItem Header="Žádný" Command="{Binding UseNoHwCommand}"
                              ToggleType="Radio" IsChecked="{Binding IsNoHwSelected, Mode=OneWay}"/>
                    <MenuItem Header="Reálný" Command="{Binding UseRealHwCommand}"
                              ToggleType="Radio" IsChecked="{Binding IsRealHwSelected, Mode=OneWay}"/>
                    <MenuItem Header="Virtuální (simulace)" Command="{Binding UseVirtualHwCommand}"
                              ToggleType="Radio" IsChecked="{Binding IsVirtualHwSelected, Mode=OneWay}"
                              ToolTip.Tip="Vyžaduje načtenou mapu (parametr map=). Bez ní se nezaloží nic."/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Utils"/>
            <MenuItem Header="Tools">
                <MenuItem Header="Sensors overview" Command="{Binding OpenSensorsCommand}"/>
                <MenuItem Header="Images" Command="{Binding OpenImagesCommand}"/>
                <MenuItem Header="Robot-centric" Command="{Binding OpenRobotCentricCommand}"/>
                <MenuItem Header="World" Command="{Binding OpenWorldViewCommand}"/>
                <MenuItem Header="Telemetrie" Command="{Binding OpenTelemetryCommand}"/>
                <MenuItem Header="Debug output" Command="{Binding OpenDebugOutputCommand}"/>
                <MenuItem Header="Virtuální senzory" Command="{Binding OpenVirtualSensorsCommand}"/>
            </MenuItem>
            <MenuItem Header="Test">
                <MenuItem Header="D435 Test" Command="{Binding TestD435Command}"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar: snímek obrazovky a videozáznam okna (doc/screen-capture.md).
             Avalonia nemá ToolBar control, proto Border + StackPanel jako jinde v UI. -->
        <Border DockPanel.Dock="Top" Padding="4,3"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Snímek" Command="{Binding CaptureShotCommand}"
                        ToolTip.Tip="Uloží PNG snímek hlavního okna do doc/media/ (shot-*.png)."/>

                <Border Width="1" Margin="4,2" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <Button Content="{Binding Mp4ButtonText}" Command="{Binding ToggleMp4Command}"
                        ToolTip.Tip="Videozáznam okna do mp4 (H.264, 15 fps, max 1280 px, limit 10 min).&#10;Vyžaduje ffmpeg v PATH nebo v ARBOT_FFMPEG."/>
                <Button Content="{Binding GifButtonText}" Command="{Binding ToggleGifCommand}"
                        ToolTip.Tip="Videozáznam okna do animovaného GIF (8 fps, max 800 px, limit 60 s).&#10;Bez ffmpegu se použije vestavěný zapisovač (kratší limit)."/>

                <Button Command="{Binding OpenCaptureFolderCommand}" Padding="7,4"
                        AutomationProperties.Name="Otevřít složku"
                        ToolTip.Tip="Otevřít složku doc/media (poslední soubor v ní označit).">
                    <!-- Vektorová ikona složky - nezávislá na dostupnosti emoji fontu (i na Armbianu).
                         Bez AutomationProperties.Name by se tlačítko hlásilo jako "Avalonia.Controls.PathIcon". -->
                    <PathIcon Width="13" Height="13"
                              Data="M1,3 L6.2,3 L7.7,5 L15,5 L15,13.5 L1,13.5 Z"/>
                </Button>

                <TextBlock Text="{Binding CaptureStatus}" VerticalAlignment="Center"
                           Margin="6,0,0,0" Opacity="0.75" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding CaptureStatus}"/>

                <!-- Jméno posledního výstupu jako odkaz; kliknutí ho otevře v přidružené aplikaci. -->
                <HyperlinkButton Content="{Binding LastFileName}" Command="{Binding OpenLastFileCommand}"
                                 IsVisible="{Binding HasLastFile}" Padding="2,0" VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding LastFilePath}"/>
            </StackPanel>
        </Border>

        <dock:DockControl Layout="{Binding Layout}"/>
    </DockPanel>

</Window>
