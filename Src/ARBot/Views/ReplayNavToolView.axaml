<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ARBot.ViewModels"
             xmlns:comm="using:ARBot.Common.Communication"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="320"
             x:Class="ARBot.Views.ReplayNavToolView"
             x:DataType="vm:ReplayNavTool">
    <Design.DataContext>
        <vm:ReplayNavTool/>
    </Design.DataContext>

    <Grid Margin="8" RowDefinitions="Auto,Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="{Binding Info}" FontFamily="Consolas,monospace" Margin="0,0,0,6"/>

        <Slider Grid.Row="1"
                Minimum="0"
                Maximum="{Binding Maximum}"
                Value="{Binding Position, Mode=TwoWay}"
                IsSnapToTickEnabled="True"
                TickFrequency="1"
                SmallChange="1" LargeChange="10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,6">
            <Button Content="◀ Krok" Command="{Binding StepBackCommand}"/>
            <Button Content="Play"    Command="{Binding PlayCommand}"/>
            <Button Content="Pause"   Command="{Binding PauseCommand}"/>
            <Button Content="Krok ▶"  Command="{Binding StepForwardCommand}"/>
        </StackPanel>

        <!-- Zahlavi gridu (fixni sirky sloupcu se musi shodovat s ItemTemplate). -->
        <Grid Grid.Row="3" Margin="4,0" ColumnDefinitions="60,120,*,90">
            <TextBlock Grid.Column="0" Text="Seq"   FontWeight="Bold" FontFamily="Consolas,monospace"/>
            <TextBlock Grid.Column="1" Text="Typ"   FontWeight="Bold" FontFamily="Consolas,monospace"/>
            <TextBlock Grid.Column="2" Text="Jméno" FontWeight="Bold" FontFamily="Consolas,monospace"/>
            <TextBlock Grid.Column="3" Text="Čas"   FontWeight="Bold" FontFamily="Consolas,monospace"/>
        </Grid>

        <!-- Grid zprav z indexu: klik na radek = seek (SelectedIndex <-> Position);
             behem Play se vyber synchronizuje jako slider (code-behind ScrollIntoView). -->
        <ListBox Grid.Row="4" x:Name="EntriesList"
                 ItemsSource="{Binding Rows}"
                 SelectedIndex="{Binding Position, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="4,0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="comm:IndexEntry">
                    <Grid ColumnDefinitions="60,120,*,90">
                        <TextBlock Grid.Column="0" Text="{Binding Seq}" FontFamily="Consolas,monospace"/>
                        <TextBlock Grid.Column="1" Text="{Binding MsgName}" FontFamily="Consolas,monospace" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontFamily="Consolas,monospace" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{Binding CaptureTime, StringFormat='HH:mm:ss.fff'}" FontFamily="Consolas,monospace"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
