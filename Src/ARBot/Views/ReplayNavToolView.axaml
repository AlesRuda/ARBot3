<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ARBot.ViewModels"
             xmlns:comm="using:ARBot.Common.Communication"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="320"
             x:Class="ARBot.Views.ReplayNavToolView"
             x:DataType="vm:ReplayNavTool">
    <Design.DataContext>
        <vm:ReplayNavTool/>
    </Design.DataContext>

    <Grid Margin="8" RowDefinitions="Auto,Auto,*">
        <!-- Ovladani na JEDNOM radku: pozice, posuvnik (roztahuje se), tlacitka.
             Play a Pauza je jedno prepinaci tlacitko - treti stav neexistuje. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="{Binding Info}" FontFamily="Consolas,monospace"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>

            <Slider Grid.Column="1"
                    Minimum="0"
                    Maximum="{Binding Maximum}"
                    Value="{Binding Position, Mode=TwoWay}"
                    IsSnapToTickEnabled="True"
                    TickFrequency="1"
                    SmallChange="1" LargeChange="10"
                    VerticalAlignment="Center"/>

            <!-- Vnejsi dvojice = skok na sousedni zpravu TEHOZ proudu (stejny typ i jmeno),
                 vnitrni = krok o jednu zpravu v zaznamu. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                <Button Content="◀◀ Stejná" Command="{Binding PrevSameCommand}"
                        ToolTip.Tip="Předchozí zpráva téhož proudu (stejný typ i jméno)."/>
                <Button Content="◀ Krok" Command="{Binding StepBackCommand}"/>
                <Button Content="{Binding PlayPauseText}" Command="{Binding TogglePlayCommand}" MinWidth="86"/>
                <Button Content="Krok ▶"  Command="{Binding StepForwardCommand}"/>
                <Button Content="Stejná ▶▶" Command="{Binding NextSameCommand}"
                        ToolTip.Tip="Následující zpráva téhož proudu (stejný typ i jméno)."/>
            </StackPanel>
        </Grid>

        <!-- Zahlavi gridu (fixni sirky sloupcu se musi shodovat s ItemTemplate). -->
        <Grid Grid.Row="1" Margin="4,0" ColumnDefinitions="60,115,150,*">
            <TextBlock Grid.Column="0" Text="Seq"   FontWeight="Bold" FontFamily="Consolas,monospace"/>
            <TextBlock Grid.Column="1" Text="Čas"   FontWeight="Bold" FontFamily="Consolas,monospace"/>
            <TextBlock Grid.Column="2" Text="Typ"   FontWeight="Bold" FontFamily="Consolas,monospace"/>
            <TextBlock Grid.Column="3" Text="Jméno" FontWeight="Bold" FontFamily="Consolas,monospace"/>
        </Grid>

        <!-- Grid zprav z indexu: klik na radek = seek (SelectedIndex <-> Position);
             behem Play se vyber synchronizuje jako slider (code-behind ScrollIntoView). -->
        <ListBox Grid.Row="2" x:Name="EntriesList"
                 ItemsSource="{Binding Rows}"
                 SelectedIndex="{Binding Position, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="4,0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="comm:IndexEntry">
                    <Grid ColumnDefinitions="60,115,150,*">
                        <TextBlock Grid.Column="0" Text="{Binding Seq}" FontFamily="Consolas,monospace"/>
                        <TextBlock Grid.Column="1" Text="{Binding CaptureTime, StringFormat='HH:mm:ss.fff'}" FontFamily="Consolas,monospace"/>
                        <TextBlock Grid.Column="2" Text="{Binding MsgName}" FontFamily="Consolas,monospace" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{Binding Name}" FontFamily="Consolas,monospace" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
