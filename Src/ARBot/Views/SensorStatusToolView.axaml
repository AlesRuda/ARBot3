<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ARBot.ViewModels"
             x:Class="ARBot.Views.SensorStatusToolView"
             x:CompileBindings="False">
    <Design.DataContext>
        <vm:SensorStatusTool/>
    </Design.DataContext>
    <Grid RowDefinitions="Auto,Auto,*">
        <Button Grid.Row="0" Classes="btn compact" Content="Refresh" Command="{Binding RefreshCommand}"
                HorizontalAlignment="Left" Margin="4"/>
        <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="Gray"
                   Margin="6,0,6,4" TextWrapping="Wrap"/>
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Sensors}" DoubleTapped="OnItemDoubleTapped"
                          ToolTip.Tip="Dvojklik otevře detail senzoru">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SensorRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="6,3" Background="Transparent">
                            <Border Grid.Column="0" Width="12" Height="12" CornerRadius="6"
                                    VerticalAlignment="Center" Background="{Binding StatusBrush}"/>
                            <TextBlock Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center"
                                       Text="{Binding Name}"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"
                                       MinWidth="48" TextAlignment="Right"
                                       Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"/>
                            <!-- Stop/Start jednotliveho senzoru. U senzoru bez vlastni smycky
                                 (MD23, fiktivni motory) se tlacitko neukazuje. -->
                            <Button Grid.Column="3" Margin="8,0,0,0" Classes="btn compact" MinWidth="52"
                                    IsVisible="{Binding CanControl}"
                                    Content="{Binding ToggleText}"
                                    Command="{Binding ToggleCommand}"
                                    ToolTip.Tip="Zastaví/spustí smyčku měření tohoto senzoru. Vypnutí NEPŘEŽIJE start runtime (Run si senzory spouští sám). U motorů se zastaví jen odometrie — kola to nezastaví."/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
