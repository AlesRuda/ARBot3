<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ARBot.ViewModels"
             x:Class="ARBot.Views.VirtualSensorsDocumentView"
             x:DataType="vm:VirtualSensorsDocument">
    <Design.DataContext>
        <vm:VirtualSensorsDocument/>
    </Design.DataContext>

    <ScrollViewer Background="#252526">
        <StackPanel Spacing="10" Margin="12" MaxWidth="480" HorizontalAlignment="Left">

            <!-- ================= Skutečná chyba lokalizace ================= -->

            <TextBlock Text="Skutečná chyba lokalizace" FontWeight="Bold" Foreground="White"/>

            <TextBlock TextWrapping="Wrap" Foreground="#A0FFFFFF" FontSize="11"
                       Text="Rozdíl mezi skutečnou pózou simulovaného robota a odhadem fúze, obojí ze stejného tiku řídicí smyčky. Klesající RMS = korekce konvergují."/>

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="skutečnost" Foreground="#A0FFFFFF"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,10,3"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TruthText}" Foreground="#8AD48A"
                           FontFamily="Consolas,monospace" Margin="0,0,0,3"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="odhad" Foreground="#A0FFFFFF"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,10,3"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EstimateText}" Foreground="White"
                           FontFamily="Consolas,monospace" Margin="0,0,0,3"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="chyba" Foreground="#A0FFFFFF"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,10,3"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ErrorText}" Foreground="#FFD48A"
                           FontFamily="Consolas,monospace" Margin="0,0,0,3"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="statistika" Foreground="#A0FFFFFF"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StatsText}" Foreground="White"
                           FontFamily="Consolas,monospace" TextWrapping="Wrap"/>
            </Grid>

            <Button Classes="btn" Content="Vynulovat statistiku" Command="{Binding ResetStatsCommand}"
                    HorizontalAlignment="Left"/>

            <TextBlock Text="{Binding StatusText}" Foreground="#A0FFFFFF" FontSize="11"
                       TextWrapping="Wrap"/>

            <Separator Margin="0,6"/>

            <!-- ================= Nouzové zastavení ================= -->

            <TextBlock Text="Nouzové zastavení" FontWeight="Bold" Foreground="White"/>

            <TextBlock TextWrapping="Wrap" Foreground="#A0FFFFFF" FontSize="11"
                       Text="Jako by obsluha držela tlačítko. Celý handshake mise Robotour na něm stojí (servisní okno, čtení QR, potvrzení cíle) — bez tohohle přepínače se v simulaci servisní okno nedá projít vůbec. Kola nezastavuje sám: o to se stará řídicí smyčka, takže robot dobrzdí svou rampou jako na železe."/>

            <CheckBox Content="Držet nouzové zastavení" IsChecked="{Binding EmergencyStop}"
                      Foreground="White"/>

            <Border Background="#5A3A00" CornerRadius="3" Padding="8,5"
                    IsVisible="{Binding EmergencyStop}">
                <TextBlock Text="⚠ Nouzové zastavení je DRŽENO — robot se nerozjede, dokud se neuvolní."
                           Foreground="#FFD48A" TextWrapping="Wrap" FontSize="11"/>
            </Border>

            <Separator Margin="0,6"/>

            <!-- ================= Systematické chyby ================= -->

            <TextBlock Text="Systematické chyby" FontWeight="Bold" Foreground="White"/>

            <TextBlock TextWrapping="Wrap" Foreground="#A0FFFFFF" FontSize="11"
                       Text="Neprůměrují se pryč — chyba polohy a kurzu roste s časem. Právě to má hranová lokalizace léčit. Prokluz 1 = ideál; rozdíl vlevo/vpravo dělá drift kurzu, stejná hodnota na obou chybu měřítka dráhy."/>

            <!-- Výstraha: nenulová chyba se snadno zapomene zapnutá -->
            <Border Background="#5A3A00" CornerRadius="3" Padding="8,5"
                    IsVisible="{Binding IsSystematicErrorActive}">
                <TextBlock Text="⚠ Systematická chyba je aktivní — odhad bude driftovat."
                           Foreground="#FFD48A" TextWrapping="Wrap" FontSize="11"/>
            </Border>

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="prokluz vlevo [-]" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,8,4"/>
                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding LeftWheelSlip}"
                               Increment="0.005" Minimum="0.5" Maximum="1.5"
                               FormatString="F4" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="prokluz vpravo [-]" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,8,4"/>
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RightWheelSlip}"
                               Increment="0.005" Minimum="0.5" Maximum="1.5"
                               FormatString="F4" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="bias kurzu [°]" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,8,4"/>
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ImuHeadingBiasDeg}"
                               Increment="0.5" FormatString="F2" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="bias gyra [°/s]" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding ImuGyroBiasDegPerSec}"
                               Increment="0.05" FormatString="F3"/>
            </Grid>

            <Button Classes="btn" Content="Vynulovat chyby" Command="{Binding ResetSystematicErrorCommand}"
                    HorizontalAlignment="Left"/>

            <Separator Margin="0,6"/>

            <!-- ================= Šum ================= -->

            <TextBlock Text="Šum senzorů" FontWeight="Bold" Foreground="White"/>

            <TextBlock TextWrapping="Wrap" Foreground="#A0FFFFFF" FontSize="11"
                       Text="Náhodný, s nulovou střední hodnotou — fúze si ho vyprůměruje a chyba zůstane ohraničená. Nula vypíná (režim pro deterministické testy). Frekvence senzorů se čtou jen při zapnutí virtuálního HW, proto tu nejsou."/>

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="GPS poloha σ [m]" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,8,4"/>
                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding GpsPositionNoiseM}"
                               Increment="0.1" Minimum="0" FormatString="F2" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="GPS rychlost σ [m/s]" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,8,4"/>
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding GpsSpeedNoiseMps}"
                               Increment="0.05" Minimum="0" FormatString="F3" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="IMU kurz σ [°]" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,8,4"/>
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ImuHeadingNoiseDeg}"
                               Increment="0.1" Minimum="0" FormatString="F2" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="IMU gyro σ [°/s]" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding ImuGyroNoiseDegPerSec}"
                               Increment="0.1" Minimum="0" FormatString="F2"/>
            </Grid>

            <Separator Margin="0,6"/>

            <!-- ================= Scéna (render kamer) ================= -->

            <TextBlock Text="Scéna kamer" FontWeight="Bold" Foreground="White"/>

            <TextBlock TextWrapping="Wrap" Foreground="#A0FFFFFF" FontSize="11"
                       Text="Mění render virtuálních kamer a platí hned. Hraniční body se do metrů přepočítávají zpětnou projekcí přes MĚŘENOU hloubku, zatímco semantický kanál lokální mapy se promítá dopředu na ROVINU země — to jsou dvě různé geometrie. S nulovým šumem hloubky a nulovou drsností trávy splynou."/>

            <Border Background="#332E7D32" BorderBrush="#4CAF50" BorderThickness="1"
                    CornerRadius="3" Padding="6,4" Margin="0,4"
                    IsVisible="{Binding IsIdealPlane}">
                <TextBlock Text="✓ Scéna je dokonalá rovina — zpětná projekce hranic je exaktní."
                           TextWrapping="Wrap" Foreground="White" FontSize="11"/>
            </Border>

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Šum hloubky σ [m]" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,8,4"
                           ToolTip.Tip="0 = přesná geometrie. Právě tenhle šum rozstřikuje vzdálené&#10;hraniční body (na 10 m p10/p90 −0,63/+0,40 m) a bere s sebou&#10;i proložení, protože RANSAC má jeden práh pro celý dosah."/>
                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding DepthNoiseM}"
                               Increment="0.001" Minimum="0" FormatString="F3" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Drsnost trávy [m]" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,8,4"
                           ToolTip.Tip="Rozptyl výšky trávy. 0 = hladká rovina."/>
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding GrassRoughnessM}"
                               Increment="0.01" Minimum="0" FormatString="F3" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Výška trávy [m]" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           ToolTip.Tip="Výška trávníku nad vozovkou. Nad nulou se na okraji cesty&#10;renderuje svislá stěna, kterou klasifikátor vidí jako překážku —&#10;při 0 je hranice v lokální mapě čistě semantická (z barvy)."/>
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding GrassHeightM}"
                               Increment="0.05" Minimum="0" FormatString="F2"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
