<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ARBot.ViewModels"
             xmlns:conv="using:ARBot.Converters"
             xmlns:ctrl="using:ARBot.Views.Controls"
             x:Class="ARBot.Views.WorldViewDocumentView"
             x:DataType="vm:WorldViewDocument"
             >
    <Design.DataContext><vm:WorldViewDocument/></Design.DataContext>

    <Grid>
        <!-- Mapa (Mapsui MapControl) se vklada v code-behind do tohoto hostu (mimo design-time). -->
        <Panel x:Name="MapHost"/>

        <!-- Ovladaci panel: podklad + prepinace vrstev (vlevo nahore). Sbalovaci, aby nebranil mape. -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                Background="#B0000000" Padding="6" CornerRadius="4">
            <StackPanel Spacing="4">
                <!-- Prepinac sbaleni (vzdy viditelny). -->
                <ToggleButton IsChecked="{Binding PanelExpanded}" HorizontalAlignment="Stretch"
                              Padding="6,2" ToolTip.Tip="Skrýt / zobrazit ovládací panel">
                    <TextBlock Text="☰  Mapa a vrstvy" Foreground="White" FontSize="12"/>
                </ToggleButton>

                <!-- Telo panelu (skryte pri sbaleni). Rolovatelne: MaxHeight se odviji od vysky mapy
                     (ancestor Grid) minus chrome, takze scrollbar naskoci prave kdyz se obsah nevejde. -->
                <ScrollViewer IsVisible="{Binding PanelExpanded}"
                              MaxHeight="{Binding $parent[Grid].Bounds.Height, Converter={x:Static conv:SubtractConverter.Instance}, ConverterParameter=70}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="4" MinWidth="190">
                <!-- PODKLAD je prvni: je to kulisa, na kterou se vse ostatni kresli.
                     Vypnuti resi JEN checkbox; v combu zamerne neni polozka "Bez podkladu",
                     protoze delala presne totez a dva prvky pro jeden stav umeji vyrobit
                     matouci stav "v combu je OSM, ale nic nevidim". -->
                <CheckBox Content="Zobrazit podklad" IsChecked="{Binding ShowBaseMap}" Foreground="White"/>

                <TextBlock Text="Podklad" Foreground="White" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{Binding BaseMapChoices}"
                          SelectedItem="{Binding SelectedBaseMap}"
                          IsEnabled="{Binding ShowBaseMap}"
                          HorizontalAlignment="Stretch"/>

                <!-- Cesta k .mbtiles jen u offline podkladu - jinde nema co ovlivnit. -->
                <StackPanel Spacing="4" IsVisible="{Binding OfflineBaseMapSelected}">
                    <TextBlock Text="MBTiles (offline):" Foreground="White" FontSize="11" Opacity="0.7" Margin="0,4,0,0"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="…" Classes="btn compact" Margin="4,0,0,0"
                                Click="OnBrowseMbTiles"/>
                        <TextBox Text="{Binding MbTilesPath}" PlaceholderText="cesta k .mbtiles"/>
                    </DockPanel>
                </StackPanel>

                <!-- Export jen u online podkladu: dlazdice se VZDY stahuji z OpenStreetMap, takze je
                     to akce "priprav si offline z online". Po dokonceni nastavi cestu k MBTiles. -->
                <StackPanel Spacing="4" IsVisible="{Binding OnlineBaseMapSelected}">
                    <Button Classes="btn" HorizontalAlignment="Stretch" Margin="0,2,0,0"
                            Content="⬇ Uložit výřez jako MBTiles"
                            IsEnabled="{Binding !Exporting}"
                            Click="OnExportMbTiles"
                            ToolTip.Tip="Stáhne dlaždice OSM aktuálního výřezu (z13–19) do MBTiles pro offline použití.&#10;Po dokončení předvyplní cestu, takže stačí přepnout podklad na Offline."/>
                </StackPanel>
                <TextBlock Text="{Binding ExportStatus}" Foreground="#FFD54F" FontSize="11"
                           TextWrapping="Wrap" IsVisible="{Binding ExportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <Separator Margin="0,4"/>

                <TextBlock Text="Vrstvy" Foreground="White" FontSize="11" Opacity="0.7"/>
                <CheckBox Content="Poloha + kurz" IsChecked="{Binding ShowRobot}" Foreground="White"
                          ToolTip.Tip="Fúzovaná póza (EKF) – tatáž, ze které vychází lokální plán."/>
                <CheckBox Content="Trajektorie" IsChecked="{Binding ShowTrajectory}" Foreground="White"
                          ToolTip.Tip="Stopa fúzované pózy."/>
                <CheckBox Content="Surové GPS" IsChecked="{Binding ShowGps}" Foreground="White"
                          ToolTip.Tip="Fixy tak, jak přišly z přijímače (šedě), bez fúze.&#10;Rozestup od žluté značky robota = aktuální chyba GPS."/>
                <CheckBox Content="Mapa (síť)" IsChecked="{Binding ShowMap}" Foreground="White"
                          ToolTip.Tip="Navigační síť z parametru map= – mapa, podle které robot jede a se kterou koreluje occupancy grid."/>
                <CheckBox Content="Mapa (vize)" IsChecked="{Binding ShowVisionMap}" Foreground="White"
                          ToolTip.Tip="Mapa z parametru visionmap=, ze které renderují virtuální kamery (oranžově).&#10;Rozestup od fialové navigační sítě = záměrně zavedená chyba mapy.&#10;Bez parametru je vrstva prázdná."/>
                <CheckBox Content="Trasa / graf" IsChecked="{Binding ShowRoute}" Foreground="White"/>
                <CheckBox Content="Značky" IsChecked="{Binding ShowMarkers}" Foreground="White"/>
                <CheckBox Content="Lokální mapa" IsChecked="{Binding ShowOccupancy}" Foreground="White"
                          ToolTip.Tip="Akumulovaná sjízdnost okolo robota (occupancy grid)"/>
                <CheckBox Content="Lokální plán" IsChecked="{Binding ShowPlan}" Foreground="White"
                          ToolTip.Tip="Naplánovaná dráha a cíl. Cíl zadáš Ctrl + klikem do mapy.&#10;&#10;Úseky jsou obarvené stropem rychlosti, který jim plánovač předepsal:&#10;modrá = plná rychlost, oranžová = brzdí, červená = stojí / plazí se.&#10;Tutéž škálu má graf rychlostního profilu vlevo dole."/>
                <CheckBox Content="Rychlostní profil plánu" IsChecked="{Binding ShowSpeedProfile}"
                          Foreground="White" Margin="16,0,0,0"
                          ToolTip.Tip="Graf vlevo dole: strop rychlosti [m/s] jako funkce vzdálenosti od robota po dráze [m].&#10;Žlutá značka v nule = aktuální rychlost robota z fúze.&#10;Čárkovaná čára = strop řízení (maxspeed). Schová se, když plán není."/>
                <CheckBox Content="Hranice cesty" IsChecked="{Binding ShowEdges}" Foreground="White"
                          ToolTip.Tip="Detekované hranice cesty z kamer (modrá = levá, oranžová = pravá),&#10;promítnuté do mapy — a přes ně PROLOŽENÉ PŘÍMKY z koridoru,&#10;i u zamítnutých cyklů (tenčí a průhlednější).&#10;&#10;Body jsou vidět vždy, ale přímky POUZE s parametrem corridor=true —&#10;bez něj se hranová lokalizace vůbec nezakládá. Stav je v rámečku vpravo dole.&#10;&#10;Každý snímek se promítá pózou z JEHO času (nese ji zpráva), takže&#10;kamery s různým časem snímku nejsou proti sobě posunuté.&#10;Ladicí vrstva — výchozí vypnuto."/>
                <CheckBox Content="Hranice ze skutečné pózy" IsChecked="{Binding ShowEdgesFromTruth}"
                          IsEnabled="{Binding ShowEdges}" Foreground="White" Margin="16,0,0,0"
                          ToolTip.Tip="Promítat hranice GROUND TRUTH pózou místo odhadu z fúze.&#10;Existuje jen na virtuálním HW (na reálném robotu ground truth není).&#10;&#10;K čemu: oddělí chybu detektoru od chyby lokalizace. Když hranice&#10;sednou na cestu se skutečnou pózou a s odhadem ne, je vedle odhad.&#10;&#10;Pro srovnání s vrstvou „Lokální mapa&quot; nechej VYPNUTÉ — grid je&#10;ukotvený odhadem z fúze, takže se kryjí jen se stejnou pózou."/>

                <Separator Margin="0,4"/>

                <CheckBox Content="Sledovat robota" IsChecked="{Binding Follow}" Foreground="White"/>

                <Separator Margin="0,4"/>

                <!-- MAPA (OsmNav) je posledni: je to NAHLED souboru, ne nastaveni pohledu.
                     Nacteni NEPREPISUJE navigacni sit z map= (ta ma vlastni vrstvu "Mapa (síť)"),
                     takze jde videt vedle sebe, cim se lisi. Smazat maze jen tenhle nahled. -->
                <TextBlock Text="Mapa (OsmNav) — náhled" Foreground="White" FontSize="11" Opacity="0.7"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Šířka cesty [m]:" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <NumericUpDown Value="{Binding DefaultRoadWidthMeters}" Minimum="0.1" Maximum="50"
                                   Increment="0.5" FormatString="0.0"
                                   ToolTip.Tip="Šířka cest bez tagu width. Výchozí hodnota je z parametru roadwidth=,&#10;tedy stejná, jakou použije robot — náhled tak ukazuje, co dostane.&#10;Když ji přetočíš, náhled už tomu neodpovídá; použitá šířka je ve stavovém řádku."/>
                </DockPanel>
                <Grid ColumnDefinitions="*,Auto">
                    <Button Grid.Column="0" Classes="btn" HorizontalAlignment="Stretch"
                            Content="Načíst OSM mapu…" Click="OnLoadOsmMap"
                            ToolTip.Tip="NÁHLED: načte .osm, sestaví síť (OsmNav) a vykreslí ji ZELENĚ jako samostatnou vrstvu.&#10;&#10;Ukazuje, co robot dostane, až mu ten soubor dáš — běžící běh NEŘÍDÍ.&#10;Robot jede podle mapy z parametru map= (fialová vrstva „Mapa (síť)“),&#10;a tu tohle tlačítko nepřepíše."/>
                    <Button Grid.Column="1" Classes="btn" Margin="4,0,0,0" Content="Smazat"
                            Click="OnClearOsmMap"
                            ToolTip.Tip="Zahodí náhledovou (zelenou) mapu. Navigační sítě z map= se to netýká."/>
                </Grid>
                <TextBlock Text="{Binding MapStatus}" Foreground="#69F0AE" FontSize="11"
                           TextWrapping="Wrap" IsVisible="{Binding MapStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Vpravo dole ve sloupci: rychlostni profil planu NAD informacnim rameckem. Vlevo dole
             nemuze - tam pri nizkem okne saha panel vrstev (overeno snimkem 3. 9. 2026). -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Spacing="4">
            <!-- Rychlostni profil planu: strop rychlosti vs. vzdalenost od robota. Prekryv, ne vrstva
                 mapy - useky planu se pohybuji, takze tooltip nad nimi je neucinny. -->
            <!-- Pozadi NEPRUHLEDNE: pres poloprůhledné prosvitaly cary podkladu (cervena carkovana
                 hranice OSM, znacky) a vypadaly jako soucast grafu - zjisteno na prvnim snimku. -->
            <Border HorizontalAlignment="Right" Background="#F2141414" Padding="4" CornerRadius="3"
                    IsVisible="{Binding SpeedProfileVisible}">
                <ctrl:PlanSpeedProfileControl Profile="{Binding PlanProfile}" Width="300" Height="130"/>
            </Border>

            <!-- Info overlay. -->
            <Border HorizontalAlignment="Right" Background="#80000000" Padding="8,4" CornerRadius="3">
                <TextBlock Text="{Binding Info}" Foreground="White" FontSize="12"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
